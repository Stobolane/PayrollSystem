<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.payrollmanagement.EmployeeManagementController">

    <VBox spacing="10" style="-fx-padding: 20;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Employee Management" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

        <!-- Employee Form -->
        <GridPane hgap="10" vgap="10">
            <Label text="Employee ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="employeeIdField" promptText="e.g. EMP001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" promptText="Full name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Department:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="departmentField" promptText="e.g. HR, IT" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Position:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="positionField" promptText="e.g. Manager" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Basic Salary:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="salaryField" promptText="e.g. 3500.00" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Working Hours:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="hoursField" promptText="e.g. 160" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Buttons -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Add" onAction="#handleAdd"/>
            <Button text="Update" onAction="#handleUpdate"/>
            <Button text="Delete" onAction="#handleDelete"/>
            <Button text="Clear" onAction="#handleClear"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>

        <!-- Employee Table -->
        <TableView fx:id="employeeTable" style="-fx-pref-height: 300;">
            <columns>
                <TableColumn fx:id="idColumn" text="Employee ID" prefWidth="100" />
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150" />
                <TableColumn fx:id="departmentColumn" text="Department" prefWidth="100" />
                <TableColumn fx:id="positionColumn" text="Position" prefWidth="100" />
                <TableColumn fx:id="salaryColumn" text="Basic Salary" prefWidth="100" />
                <TableColumn fx:id="hoursColumn" text="Working Hours" prefWidth="100" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>