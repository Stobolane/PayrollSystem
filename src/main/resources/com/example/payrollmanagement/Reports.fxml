<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.payrollmanagement.ReportsController"
      spacing="15" alignment="CENTER" prefWidth="600" prefHeight="600">

    <Label text="Payroll Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="10">
        <Button text="Available Employees" onAction="#showAvailableEmployeesReport" />
        <Button text="Revenue" onAction="#showRevenueReport" />
        <Button text="Hours Worked" onAction="#showWorkingHoursReport" />
    </HBox>

    <StackPane fx:id="chartContainer" prefHeight="450" prefWidth="550" />
</VBox>
