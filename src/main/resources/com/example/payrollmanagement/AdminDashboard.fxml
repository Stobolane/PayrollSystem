<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.payrollmanagement.AdminDashboardController">

    <!-- Top Header -->
    <top>
        <HBox spacing="20" styleClass="header" style="-fx-padding: 10;">
            <Label text="Admin Dashboard" styleClass="header-title"/>
            <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="welcome-label"/>
                <Button text="Logout" onAction="#handleLogout" styleClass="logout-btn"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation -->
    <left>
        <FlowPane orientation="VERTICAL" vgap="12" hgap="0" styleClass="sidebar" prefWidth="220" style="-fx-padding: 10;">
            <Button styleClass="nav-btn" text="📊  Dashboard" onAction="#showDashboard"/>
            <Button styleClass="nav-btn" text="👥  Employees" onAction="#showEmployeeManagement"/>
            <Button fx:id="reportsButton" text="Reports" onAction="#handleReportsButtonClick"/>
            <Button styleClass="nav-btn" text="💰  Payslip Generation" onAction="#showPayslipGeneration"/>
            <Button styleClass="nav-btn" text="📈  Salary Calculation" onAction="#showSalaryCalculation"/>
        </FlowPane>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-pane">
            <!-- Default Home Content -->
            <VBox fx:id="homeContent" spacing="20" styleClass="dashboard-content" alignment="CENTER">
                <Text text="Welcome to Admin Home" styleClass="title"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox styleClass="summary-card" prefWidth="200" prefHeight="100" alignment="CENTER">
                        <Label text="Total Users" styleClass="card-title"/>
                        <Label fx:id="totalUsersLabel" text="0" styleClass="card-value"/>
                    </VBox>
                    <VBox styleClass="summary-card" prefWidth="200" prefHeight="100" alignment="CENTER">
                        <Label text="Pending Requests" styleClass="card-title"/>
                        <Label fx:id="pendingRequestsLabel" text="0" styleClass="card-value"/>
                    </VBox>
                </HBox>
                <TableView fx:id="homeActivityTable" styleClass="admin-table" prefHeight="200" prefWidth="600">
                    <columns>
                        <TableColumn fx:id="activityColumn" text="Recent Activity" prefWidth="600"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Payslip Generation -->
            <VBox fx:id="payslipContent" spacing="10" alignment="CENTER">
                <TextField fx:id="empIdField" promptText="Enter Employee ID"/>
                <Button text="Generate Payslip" onAction="#handleGeneratePayslip"/>
            </VBox>

            <!-- Salary Calculation -->
            <VBox fx:id="salaryCalcContent" spacing="20" alignment="CENTER" visible="false" styleClass="dashboard-content">
                <Text text="Salary Calculation" styleClass="title"/>
                <Button text="Calculate Salary" onAction="#handleCalculateSalary"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>